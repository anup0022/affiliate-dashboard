generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  image          String?
  hashedPassword String?

  accounts        Account[]
  sessions        Session[]
  affiliateLinks  AffiliateLink[]
  recommendations Recommendation[]
  adCampaigns     AdCampaign[]
  earnings        Earning[]
  chatMessages    ChatMessage[]
  apiCredentials  ApiCredential[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TrendingItem {
  id                  String  @id @default(cuid())
  title               String
  description         String? @db.Text
  category            String
  trendScore          Float
  source              String
  sourceUrl           String?
  imageUrl            String?
  affiliateNetwork    String?
  estimatedCommission Float?
  searchVolume        Int?
  competition         String?
  data                Json?

  recommendations Recommendation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AffiliateLink {
  id               String  @id @default(cuid())
  userId           String
  title            String
  url              String
  affiliateNetwork String
  productName      String?
  category         String?
  commissionRate   Float?
  status           String  @default("active")
  clicks           Int     @default(0)
  conversions      Int     @default(0)
  revenue          Float   @default(0)

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  adCampaigns AdCampaign[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Recommendation {
  id                String  @id @default(cuid())
  userId            String
  title             String
  description       String? @db.Text
  reasoning         String? @db.Text
  category          String
  confidence        Float
  trendingItemId    String?
  affiliateNetwork  String?
  estimatedEarnings Float?
  actionItems       Json?
  status            String  @default("new")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  trendingItem TrendingItem? @relation(fields: [trendingItemId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}

model AdCampaign {
  id              String    @id @default(cuid())
  userId          String
  title           String
  platform        String    @default("google")
  affiliateLinkId String?
  budget          Float
  spent           Float     @default(0)
  impressions     Int       @default(0)
  clicks          Int       @default(0)
  conversions     Int       @default(0)
  status          String    @default("draft")
  adCopy          String?   @db.Text
  targetKeywords  Json?
  startDate       DateTime?
  endDate         DateTime?

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  affiliateLink AffiliateLink? @relation(fields: [affiliateLinkId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Earning {
  id               String  @id @default(cuid())
  userId           String
  affiliateNetwork String
  amount           Float
  currency         String  @default("USD")
  period           String
  source           String?
  details          Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model ChatMessage {
  id       String @id @default(cuid())
  userId   String
  role     String
  content  String @db.Text
  metadata Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model ApiCredential {
  id          String  @id @default(cuid())
  userId      String
  service     String
  apiKey      String
  apiSecret   String?
  accessToken String?
  isActive    Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, service])
}
